# ---------------------------------------------------------------------------
# Oracle Cloud A1 Capacity Hunter — settings template.
# setup.sh copies this to config.env on first run. Edit config.env, not this file.
# Values marked AUTO are discovered by setup.sh; leave blank.
# ---------------------------------------------------------------------------

# --- Identity -------------------------------------------------------------
# LEAVE THESE BLANK. setup.sh reads your tenancy OCID straight out of
# ~/.oci/config, which is never part of this repo. Only set them by hand if
# you target a non-root compartment -- and if you do, remember that your real
# config.env is gitignored precisely so those values never reach GitHub.
TENANCY_OCID=""
COMPARTMENT_OCID=""

# OCI CLI profile inside ~/.oci/config
OCI_PROFILE="DEFAULT"

# --- What to grab ---------------------------------------------------------
SHAPE="VM.Standard.A1.Flex"

# The ladder. One rung is attempted per cycle, rotating top to bottom, so the
# request rate stays exactly the same as hunting a single shape -- you just ask
# a different question each time instead of the same one over and over.
#
# Format: "OCPUS:MEMORY_GB:BOOT_VOLUME_GB"
#
# Descend on CORES, not storage. "Out of host capacity" is a statement about
# the ARM compute host; boot volume comes from a separate block-storage pool
# and has no bearing on it. Two rungs with the same cores and different disk
# would be the identical question asked twice.
#
# Always Free ceilings: 4 OCPU + 24 GB RAM total, 200 GB block storage total.
# A rung is only worth listing if you would actually accept it.
TIERS=(
  "4:24:200"   # the whole allowance in one box
  "3:18:150"
  "2:12:100"
)

# Rotation means the smallest rung will usually land first, since 1-2 core
# holes open far more often than 4-core ones. To weight the hunt toward the
# big box, list it more than once:
#   TIERS=("4:24:200" "4:24:200" "4:24:200" "2:12:100")
# To hold out for 4/24 only, list that single rung.

INSTANCE_NAME="free-arm-1"

# Image selection (setup.sh resolves these to an OCID)
IMAGE_OS="Canonical Ubuntu"
IMAGE_OS_VERSION="24.04"

# SSH public key injected into the instance
SSH_PUBKEY_FILE="$HOME/.ssh/id_ed25519.pub"
# Login user for the chosen image (ubuntu for Canonical, opc for Oracle Linux)
SSH_LOGIN_USER="ubuntu"

# --- Cadence --------------------------------------------------------------
# Seconds between launch attempts. 60 is the tested sweet spot.
# Below ~45 you start earning HTTP 429s, which makes the hunt SLOWER.
BASE_INTERVAL=60
# Random 0..JITTER seconds added to each interval so attempts aren't robotic.
JITTER=20

# Backoff ceiling for the punitive sleep right after a 429 (seconds). 32 minutes.
MAX_BACKOFF=1920

# The loop self-tunes its cadence between BASE_INTERVAL and MAX_INTERVAL:
# every 429 pushes the interval up by INTERVAL_STEP, and a run of clean
# responses walks it back down. Different tenancies get different rate limits,
# so the right interval is discovered rather than guessed.
MAX_INTERVAL=300
INTERVAL_STEP=30
CLEAN_RUN_TO_SPEED_UP=3

# --- Alerts ---------------------------------------------------------------
ALERT_SOUND="/System/Library/Sounds/Glass.aiff"
ALERT_REPEATS=3
